# ----------------------------------------------------------------------------
# Kapabara POS & Inventory — environment variables
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# NEVER commit `.env` to version control.
#
# Schema is enforced at build time by `src/env.js` using @t3-oss/env-nextjs.
# Update both this file and `src/env.js` if you add a new variable.
# ----------------------------------------------------------------------------

# === Required on every environment ===

# Postgres connection string.
# - Local dev:  postgresql://postgres:password@localhost:5432/kapabara
# - Cloud:      postgresql://USER:PASS@HOST:5432/DB?sslmode=require
# Most managed providers (Neon, Supabase, Railway, Prisma Postgres, RDS)
# require `?sslmode=require` on the query string.
DATABASE_URL="postgresql://postgres:password@localhost:5432/kapabara"

# Auth.js v5 — JWT signing secret. Generate with:
#   openssl rand -hex 32
# or   npx auth secret
# The same secret is shared across deployments of the same environment; rotate
# by setting a new value and redeploying (will log every user out).
AUTH_SECRET="generate-with-openssl-rand-hex-32"

# Required when running behind a proxy (Vercel, Netlify, Cloud Run, ...).
# Auth.js v5 needs to trust the X-Forwarded-Host header that the platform
# injects; without this, all sign-in flows will fail.
AUTH_TRUST_HOST="true"

# === Set automatically by Vercel (do not override) ===
# NODE_ENV is set to "production" by Vercel on deploys, and "development" by
# `next dev`. We declare it here for completeness so `src/env.js` is happy
# when running tests or build previews.
NODE_ENV="development"
